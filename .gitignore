node_modules/
# tsc -b emit. Typecheck and tests resolve the "source" export and do not read dist/.
packages/*/dist/
*.tsbuildinfo

# JSON reporter from `npm test -- --reporter=json` (input to scripts/check-counts.ts)
.vitest-report.json
.DS_Store
*.log
.env
.env.*
!.env.example
.cosigner/
# Local co-signer key (npm run cosigner:local). The default dir is .cosigner/; this
# also covers a DATA_DIR inside the repo. Never commit it.
cosigner.seed
**/cosigner.seed
**/.cosigner.seed.*.tmp
cosigner.token
**/cosigner.token
**/.cosigner.token.*.tmp
# eng open --out. The CLI also refuses any path inside the repo.
eng-open.out
*.eng-open.json
/spike/
packages/*/demo/results/
packages/web/.web-decisions/
# Local demo recordings. The shot list stays in docs/; the files stay on the machine.
docs/video/

# pre-created account pool: local seed + state store (never commit)
.pool/
**/.pool/
.superpowers/
