# Engagement-accounts demo + pool configuration.
# Copy this file to `.env` in the repo root and fill in the values. `.env` is gitignored —
# NEVER commit real seeds. It is loaded automatically by `npm run web` and `npm run pool:*`
# (an inline `VAR=x npm run …` still overrides a value here).

# --- Pooled web demo (packages/web) ---
ENG_USE_POOL=1               # 1 = lease pre-aged pool accounts; unset/0 = self-contained per-run faucet demo
ENG_SPONSOR_SEED=sEd...      # operating account: funds each pooled account's XRP reserve, receives every reclaim
ENG_SERVICE_SEED=sEd...      # pool service key: each pooled account's RegularKey; signs pre-create + pool-only reclaim
ENG_RLUSD_ISSUER=r...        # RLUSD issuer ADDRESS the pool trust-lines to (the fixed demo issuer's address)
ENG_DEMO_ISSUER_SEED=sEd...  # seed of that fixed, self-controlled demo RLUSD issuer (the web demo mints the budget from it)

# --- Privy-custodied signing (sign-not-export) ---
# Lets the agent and/or policy co-signer sign through a key held in Privy instead of a local seed.
# These two alone run `npm run demo:privy` (it provisions a throwaway XRPL wallet on the fly):
PRIVY_APP_ID=...             # Privy app id
PRIVY_APP_SECRET=...         # Privy app secret — NEVER commit a real value
# To make the agent / co-signer sign through a Privy-held key, also set the source + wallet details:
# AGENT_KEY_SOURCE=privy                     # agent signs via Privy (else a local AGENT_SEED)
# COSIGNER_KEY_SOURCE=privy                  # co-signer signs via Privy (else COSIGNER_SEED / COSIGNER_SEED_FILE)
# PRIVY_WALLET_ID=...                        # the Privy XRPL wallet id
# PRIVY_WALLET_ADDRESS=r...                  # its r-address (a SignerList member)
# PRIVY_WALLET_PUBKEY=...                    # its 33-byte compressed secp256k1 public key (hex)
# PRIVY_AUTHORIZATION_KEY=...                # production hardening: the wallet owner's authorization key (base64 PKCS8 P-256,
#                                            # `wallet-auth:` prefix ok) — each raw_sign then carries a generated signature

# --- Optional (sensible defaults shown) ---
# ENG_POOL_SPONSORED=1                        # XLS-68 sponsored mode — needs the Sponsor amendment; NOT enabled on Testnet
# ENG_RLUSD_CURRENCY=RLUSD
# ENG_RLUSD_LIMIT=1000000000
# ENG_CREATE_DROPS=3000000                    # XRP drops funded per pooled account (self-funded mode)
# ENG_POOL_TARGET=5                           # desired warm pool size
# ENG_POOL_DIR=.pool                          # local pool store directory (gitignored)
# ENG_XRPL_WSS=wss://s.altnet.rippletest.net:51233   # endpoint the pool CLI uses
# XRPL_URL=wss://s.altnet.rippletest.net:51233        # endpoint the web server uses
# PORT=8080
