{
  "name": "xrpl-engagement-accounts",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate-templates": "tsx packages/core/src/cli.ts validate-template templates/*.json",
    "lint-policies": "tsx packages/policy/src/cli.ts lint",
    "vectors:build": "tsx vectors/build.ts",
    "cosigner": "tsx packages/cosigner/src/server.ts",
    "demo:b1": "tsx packages/cosigner/demo/b1-testnet.ts",
    "demo:hotel": "tsx packages/cosigner/demo/hotel-testnet.ts",
    "vectors:check": "vitest run packages/policy/test/vectors.test.ts",
    "probe:x402": "tsx packages/cosigner/demo/x402-probe.ts",
    "probe:sponsor": "tsx packages/cosigner/demo/sponsor-probe.ts",
    "test:x402": "vitest run -c vitest.x402.config.ts",
    "test:mpp": "vitest run -c vitest.mpp.config.ts",
    "typecheck:x402": "tsc -p tsconfig.x402.json --noEmit",
    "demo:x402": "tsx packages/cosigner/demo/x402/b1-x402-testnet.ts",
    "demo:privy": "tsx packages/cosigner/demo/privy-engagement-testnet.ts",
    "demo:mpp": "tsx packages/cosigner/demo/mpp/b1-mpp-testnet.ts",
    "mcp": "tsx packages/agent-mcp/src/server.ts",
    "demo:mcp": "tsx packages/agent-mcp/demo/b1-mcp-testnet.ts",
    "web": "tsx packages/web/src/server.ts",
    "demo": "tsx packages/web/src/demo.ts",
    "web:hotel-sim": "tsx packages/web/scripts/hotel-sim.ts",
    "web:policy-text": "tsx packages/web/scripts/policy-text.ts",
    "web:disclosure": "tsx packages/web/scripts/disclosure.ts",
    "pool:status": "tsx packages/cosigner/src/pool-cli.ts status",
    "pool:topup": "tsx packages/cosigner/src/pool-cli.ts topup",
    "pool:ensure": "tsx packages/cosigner/src/pool-cli.ts ensure",
    "pool:reclaim": "tsx packages/cosigner/src/pool-cli.ts reclaim",
    "pool:gc": "tsx packages/cosigner/src/pool-cli.ts gc"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.3",
    "x402-xrpl-settlement-adapter": "^0.3.0"
  },
  "dependencies": {
    "@marcbachmann/cel-js": "8.0.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "ripple-binary-codec": "2.11.0",
    "ripple-keypairs": "^3.1.0",
    "xrpl": "5.3.0",
    "zod": "^3.25.76"
  }
}
