{
  "name": "xrpl-engagement-accounts",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "vitest run",
    "test:sweep": "vitest run -c vitest.sweep.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -b tsconfig.build.json --pretty false",
    "pack-smoke": "tsx --conditions=source scripts/pack-smoke.ts",
    "validate-templates": "tsx --conditions=source packages/core/src/cli.ts validate-template templates/*.json",
    "costs": "tsx --conditions=source scripts/costs.ts",
    "lint-policies": "tsx --conditions=source packages/policy/src/cli.ts lint",
    "vectors:build": "tsx --conditions=source vectors/build.ts",
    "cosigner": "tsx --conditions=source packages/cosigner/src/server.ts",
    "cosigner:local": "tsx --conditions=source packages/cosigner/src/local.ts",
    "demo:b1": "tsx --conditions=source packages/cosigner/demo/b1-testnet.ts",
    "demo:hotel": "tsx --conditions=source packages/cosigner/demo/hotel-testnet.ts",
    "demo:hotel-dispute": "tsx --conditions=source packages/cosigner/demo/hotel-dispute-testnet.ts",
    "demo:marketplace-escrow": "tsx --conditions=source packages/cosigner/demo/marketplace-escrow-testnet.ts",
    "demo:marketplace-escrow-dispute": "tsx --conditions=source packages/cosigner/demo/marketplace-escrow-testnet.ts --clip3",
    "vectors:check": "vitest run packages/policy/test/vectors.test.ts",
    "probe:x402": "tsx --conditions=source packages/cosigner/demo/x402-probe.ts",
    "probe:sponsor": "tsx --conditions=source packages/cosigner/demo/sponsor-probe.ts",
    "test:x402": "vitest run -c vitest.x402.config.ts",
    "test:mpp": "vitest run -c vitest.mpp.config.ts",
    "typecheck:x402": "tsc -p tsconfig.x402.json --noEmit",
    "demo:x402": "tsx --conditions=source packages/cosigner/demo/x402/b1-x402-testnet.ts",
    "demo:x402:t54": "tsx --conditions=source packages/cosigner/demo/x402/b1-x402-t54-testnet.ts",
    "demo:privy": "tsx --conditions=source packages/cosigner/demo/privy-engagement-testnet.ts",
    "demo:mpp": "tsx --conditions=source packages/cosigner/demo/mpp/b1-mpp-testnet.ts",
    "mcp": "tsx --conditions=source packages/agent-mcp/src/bin/eng-mcp.ts",
    "eng": "tsx --conditions=source packages/agent-mcp/src/eng.ts",
    "test:open": "vitest run -c vitest.open.config.ts",
    "demo:mcp": "tsx --conditions=source packages/agent-mcp/demo/b1-mcp-testnet.ts",
    "web": "tsx --conditions=source packages/web/src/server.ts",
    "demo": "tsx --conditions=source packages/web/src/demo.ts",
    "web:hotel-sim": "tsx --conditions=source packages/web/scripts/hotel-sim.ts",
    "web:policy-text": "tsx --conditions=source packages/web/scripts/policy-text.ts",
    "web:disclosure": "tsx --conditions=source packages/web/scripts/disclosure.ts",
    "pool:status": "tsx --conditions=source packages/cosigner/src/pool-cli.ts status",
    "pool:topup": "tsx --conditions=source packages/cosigner/src/pool-cli.ts topup",
    "pool:ensure": "tsx --conditions=source packages/cosigner/src/pool-cli.ts ensure",
    "pool:reclaim": "tsx --conditions=source packages/cosigner/src/pool-cli.ts reclaim",
    "pool:gc": "tsx --conditions=source packages/cosigner/src/pool-cli.ts gc",
    "check-counts": "tsx --conditions=source scripts/check-counts.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "5.9.3",
    "vitest": "^5.0.3",
    "x402-xrpl-settlement-adapter": "^0.5.1",
    "xrpl": "5.3.0"
  }
}
